# ─────────────────────────────────────────────────────────────────────────────
# IS Copilot — environment variables
# Copy to `.env` (never commit `.env`). All variables below are SERVER-SIDE only
# and are never exposed to the React bundle. Leave everything unset for DEMO MODE.
# ─────────────────────────────────────────────────────────────────────────────

# LLM provider: demo | anthropic | openai | groq  (default: demo)
AI_PROVIDER=demo

# Anthropic (used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# OpenAI (used when AI_PROVIDER=openai and/or EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq (used when AI_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding provider: local | voyage   (default: local)
# NOTE: the pgvector column dimension must match the provider (see supabase/migrations).
EMBEDDING_PROVIDER=local
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3-lite

# Supabase (optional — when unset, the in-memory demo repository is used)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Limits
MAX_UPLOAD_MB=10
RATE_LIMIT_PER_MINUTE=60
